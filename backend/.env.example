# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Local fallback or Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/eldercare-connect

# JSON Web Token Secret
JWT_SECRET=supersecretchangeinproduction123

# Backend API Base URL
BACKEND_URL=http://localhost:5000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# SMTP Configuration (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ElderCare Connect" <noreply@eldercareconnect.com>

# Cloudinary Configuration (Optional - fallbacks to local disk storage if undefined)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

